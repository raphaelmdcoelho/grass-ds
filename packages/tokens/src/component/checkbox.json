{
  "checkbox": {
    "size": {
      "$type": "dimension",
      "$value": "{control.indicator-size}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.small}"
    },
    "background": {
      "$type": "color",
      "$value": "{color.surface.raised}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.strong}"
    },
    "background-checked": {
      "$type": "color",
      "$value": "{color.action.primary.background}"
    },
    "foreground-checked": {
      "$type": "color",
      "$value": "{color.action.primary.foreground}"
    }
  }
}
