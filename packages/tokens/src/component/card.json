{
  "card": {
    "background": {
      "$type": "color",
      "$value": "{color.surface.raised}"
    },
    "foreground": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "foreground-muted": {
      "$type": "color",
      "$value": "{color.text.muted}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "divider": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.surface}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{layout.inset.default}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{layout.gap.tight}"
    },
    "title-size": {
      "$type": "dimension",
      "$value": "{text.size.heading-4}"
    },
    "title-weight": {
      "$type": "fontWeight",
      "$value": "{text.weight.heading}"
    },
    "title-line-height": {
      "$type": "number",
      "$value": "{text.line-height.heading}"
    },
    "shadow-elevated": {
      "$type": "shadow",
      "$value": "{elevation.overlay}"
    }
  }
}
