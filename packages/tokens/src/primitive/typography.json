{
  "font": {
    "family": {
      "$type": "fontFamily",
      "figtree": {
        "$value": [
          "Figtree",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Ratio 1.25 scale from a 16px body; fixed sizes, no fluid type.",
      "sm": { "$value": "0.8rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.5625rem" },
      "2xl": { "$value": "1.9531rem" },
      "3xl": { "$value": "2.4414rem" },
      "4xl": { "$value": "3.0518rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 }
    }
  }
}
