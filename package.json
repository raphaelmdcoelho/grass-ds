{
  "name": "grass-ds",
  "private": true,
  "version": "0.0.0-development",
  "description": "Grass Design System: tokens, style layer and framework implementations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelmdcoelho/grass-ds.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r run build",
    "test": "pnpm -r --if-present run test",
    "check:contrast": "pnpm --filter @grass-ds/tokens run check:contrast",
    "build:catalog": "pnpm build && pnpm --filter @grass-ds/catalog-reference run build-storybook",
    "storybook": "pnpm build && pnpm --filter @grass-ds/catalog-reference run storybook",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
